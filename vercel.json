{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["cdg1"],
  "rewrites": [
    { "source": "/api/auth/:step", "destination": "/api/account?route=auth-:step" },
    { "source": "/api/me", "destination": "/api/account?route=me" },
    { "source": "/api/signout", "destination": "/api/account?route=signout" },
    { "source": "/api/buy", "destination": "/api/account?route=buy" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
